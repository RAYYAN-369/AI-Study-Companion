# ==========================
# LLM API (Groq)
# ==========================
GROQ_API_KEY=

# ==========================
# Qdrant
# ==========================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=study_companion

# ==========================
# Backend server
# ==========================
HOST=0.0.0.0
PORT=8000

# Comma-separated list of origins allowed to call the API (dev defaults
# cover opening files/*.html directly and via a local static server).
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000,null

# ==========================
# Uploads
# ==========================
UPLOAD_FOLDER=backend/uploads
# Max upload size in MB -- keep in sync with files/config.js on the frontend.
MAX_FILE_SIZE_MB=10

# ==========================
# Chunking
# ==========================
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# ==========================
# Embedding model
# ==========================
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
